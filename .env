# Focusly 环境配置
# ------------------------------------------------------------------
# VITE_API_BASE_URL 留空 = 纯 LocalStorage 本地模式（日常使用，数据不丢）
# 配置 Apifox Mock 地址 = 实训演示模式（模拟标准前后端交互）
#   示例：VITE_API_BASE_URL=https://m1.apifoxmock.com/m1/1234567-0-default/api
# ------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_API_TIMEOUT=3000
